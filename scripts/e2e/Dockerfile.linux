FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates dbus-x11 xvfb openbox xdotool xclip wmctrl x11-utils python3 python3-tk python3-pil python3-pil.imagetk libgtk-3-0 libayatana-appindicator3-1 libasound2 libpulse0 libxdo3 libxtst6 libxfixes3 libxcb-randr0 libxcb-shape0 libxcb-xfixes0 libgbm1 libgl1 libegl1 libgles2 libgl1-mesa-dri libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 iproute2 iptables procps fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash guest && mkdir /proofs && chown guest:guest /proofs
COPY scripts/e2e/linux-fixture.py /fixture.py
COPY scripts/e2e/start-linux-desktop.sh /start-desktop.sh
RUN chmod 755 /start-desktop.sh
ENV DISPLAY=:99 HOME=/home/guest LANG=C.UTF-8
USER guest
ENTRYPOINT ["/start-desktop.sh"]
