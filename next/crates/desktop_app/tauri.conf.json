{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixel Remote",
  "version": "0.1.0",
  "identifier": "ch.mixel.remote.next.qa",
  "build": {
    "frontendDist": "../../frontends/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Mixel-Remote",
        "url": "index.html",
        "width": 1160,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
