{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixel Remote",
  "version": "0.1.0",
  "identifier": "ch.mixel.remote.next.qa",
  "build": {
    "frontendDist": "../../frontends/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Mixel-Remote \u2014 Native Capture QA",
        "url": "index.html",
        "width": 1000,
        "height": 780
      },
      {
        "label": "fixture",
        "title": "Mixel-Remote Capture Fixture",
        "url": "fixture.html",
        "width": 640,
        "height": 420,
        "x": 50,
        "y": 60
      }
    ]
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
