[Unit]
Description=Mixel Meet (rooms, lobby and signaling for small meetings)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/mixel-meet/server.mjs
WorkingDirectory=/opt/mixel-meet
EnvironmentFile=/etc/mixel-meet.env
DynamicUser=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=300M

[Install]
WantedBy=multi-user.target
