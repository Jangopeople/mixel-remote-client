<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mixel Remote for Windows (WinUI 3). Unpackaged and self-contained: the installer copies this folder
       to %LOCALAPPDATA%\Mixel Remote, where Mixel Remote 0.1 lived, so it updates that app in place. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MixelRemote.App</RootNamespace>
    <AssemblyName>mixel-remote</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mixel-remote.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(Lab)' == 'true'">$(DefineConstants);LAB</DefineConstants>
    <AssemblyTitle>Mixel Remote</AssemblyTitle>
    <Product>Mixel Remote</Product>
    <!-- Native engine built by scripts/build.ps1 (crate mixel_core_capi). -->
    <MixelCore Condition="'$(MixelCore)' == ''">..\..\core</MixelCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixelRemote.Core\MixelRemote.Core.csproj" />
    <ProjectReference Include="..\MixelRemote.Lab\MixelRemote.Lab.csproj" Condition="'$(Lab)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Lab)' != 'true'">
    <Compile Remove="Lab\UiLiveCheck.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\mixel-remote.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mixel-mark.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MixelCore)\mixel_core.dll" Link="mixel_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MixelCore)\mixel_core.dll')" />
    <None Include="$(MixelCore)\mixel-remote-helper.exe" Link="mixel-remote-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MixelCore)\mixel-remote-helper.exe')" />
  </ItemGroup>
</Project>
