<Project>
  <!-- Shared by the app, the core library and the tests. Warnings fail the build (the .NET analyzers'
       default rule set is the lint). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Version>2.0.2</Version>
    <Company>Mixel IT and Corporate Services</Company>
    <Product>Mixel Remote</Product>
    <Copyright>© Mixel IT and Corporate Services</Copyright>
  </PropertyGroup>
</Project>
