    "Deletes the company at once: devices, invitations, members and their accounts. The subscription ends. Type the company name to confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Firma sofort: Geräte, Einladungen, Mitglieder und ihre Konten. Das Abonnement endet. Geben Sie zur Bestätigung den Firmennamen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l’entreprise immédiatement : appareils, invitations, membres et leurs comptes. L’abonnement prend fin. Saisissez le nom de l’entreprise pour confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella subito l’azienda: dispositivi, inviti, membri e i loro account. L’abbonamento termina. Digiti il nome dell’azienda per confermare."
          }
        }
      }
    },
    "Deletes your Mixel Remote account and signs you out on every device. Company data stays with the company.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Ihr Mixel-Remote-Konto und meldet Sie auf allen Geräten ab. Firmendaten bleiben bei der Firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre compte Mixel Remote et vous déconnecte sur tous les appareils. Les données de l’entreprise restent à l’entreprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella il Suo account Mixel Remote e La disconnette su tutti i dispositivi. I dati aziendali restano all’azienda."
          }
        }
      }
    },
