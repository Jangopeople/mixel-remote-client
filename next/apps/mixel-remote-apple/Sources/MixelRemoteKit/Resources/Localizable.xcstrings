{
  "sourceLanguage": "en",
  "strings": {
    "%@ trial until %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Testphase bis %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ essai jusqu’au %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prova fino al %@"
          }
        }
      }
    },
