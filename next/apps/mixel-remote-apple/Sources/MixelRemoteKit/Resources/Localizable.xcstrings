    "The connection ends for both sides.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wird für beide Seiten beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion se termine pour les deux côtés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione termina per entrambe le parti."
          }
        }
      }
    },
    "The connection was not established. The other side declined, did not answer, or unattended access is not allowed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung kam nicht zustande. Die Gegenseite hat abgelehnt, nicht geantwortet oder unbeaufsichtigter Zugriff ist nicht erlaubt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’a pas pu être établie. L’autre côté a refusé, n’a pas répondu ou l’accès sans surveillance n’est pas autorisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione non è stata stabilita. L’altra parte ha rifiutato, non ha risposto oppure l’accesso non presidiato non è consentito."
          }
        }
      }
    },
    "The device was changed by someone else. Refresh the list and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wurde von jemand anderem geändert. Aktualisieren Sie die Liste und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil a été modifié par quelqu’un d’autre. Actualisez la liste et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo è stato modificato da qualcun altro. Aggiorni l’elenco e riprovi."
          }
        }
      }
    },
    "The list could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste konnte nicht gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste n’a pas pu être lue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’elenco."
          }
        }
      }
    },
    "The other computer cannot take a second technician directly. Use a meeting link instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der andere Computer kann keinen zweiten Techniker direkt aufnehmen. Verwenden Sie stattdessen einen Meeting-Link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre ordinateur ne peut pas accueillir directement un deuxième technicien. Utilisez plutôt un lien de réunion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altro computer non può accogliere direttamente un secondo tecnico. Usi invece un link di riunione."
          }
        }
      }
    },
    "The people who may connect to this computer are managed in the administration console of its company.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
