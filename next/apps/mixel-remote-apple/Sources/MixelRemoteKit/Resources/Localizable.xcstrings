{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@) is signed out of Mixel Remote and can no longer be reached. You can add it again later from that computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) wird von Mixel Remote abgemeldet und ist nicht mehr erreichbar. Sie können es später an diesem Computer wieder hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) est déconnecté de Mixel Remote et n’est plus joignable. Vous pourrez le rajouter plus tard depuis cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) viene disconnesso da Mixel Remote e non è più raggiungibile. Potrà aggiungerlo di nuovo più tardi da quel computer."
          }
        }
      }
    },
