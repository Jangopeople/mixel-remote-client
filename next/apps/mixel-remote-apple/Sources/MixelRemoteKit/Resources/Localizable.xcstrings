    "Add this computer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Computer hinzufügen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter cet ordinateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo computer"
          }
        }
      }
    },
    "Add this computer to %@ so you can connect from it and to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie diesen Computer zu %@ hinzu, um von ihm aus und zu ihm zu verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet ordinateur à %@ pour vous connecter depuis et vers lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunga questo computer a %@ per connettersi da e verso di esso."
          }
        }
      }
    },
    "Add this computer, or add other computers with a deploy link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie diesen Computer hinzu oder weitere Computer mit einem Verteil-Link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez cet ordinateur, ou d’autres ordinateurs avec un lien de déploiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questo computer, o altri computer con un link di distribuzione."
          }
        }
      }
    },
    "Additional verification is required for this Mixel account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Mixel-Konto ist eine zusätzliche Bestätigung nötig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification supplémentaire est requise pour ce compte Mixel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo account Mixel serve una verifica aggiuntiva"
          }
        }
      }
    },
    "Adds the printer “Mixel Remote Printer” to this computer. What is printed on it during a session arrives at the technician, who prints it on a printer there. Needs administrator approval on this computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt diesem Computer den Drucker «Mixel Remote Printer» hinzu. Was während einer Sitzung darauf gedruckt wird, kommt beim Techniker an, der es dort auf einem Drucker ausdruckt. Benötigt die Zustimmung eines Administrators auf diesem Computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute l’imprimante « Mixel Remote Printer » à cet ordinateur. Ce qui y est imprimé pendant une session arrive chez le technicien, qui l’imprime sur une imprimante sur place. Nécessite l’accord d’un administrateur sur cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge la stampante «Mixel Remote Printer» a questo computer. Ciò che viene stampato durante una sessione arriva al tecnico, che lo stampa su una stampante presso di sé. Richiede l’approvazione di un amministratore su questo computer."
          }
        }
      }
    },
