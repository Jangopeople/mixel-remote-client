            "value": "La sessione è pronta."
          }
        }
      }
    },
    "The session stays open while Mixel Remote asks that computer again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung bleibt offen, während Mixel Remote diesen Computer erneut anfragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
