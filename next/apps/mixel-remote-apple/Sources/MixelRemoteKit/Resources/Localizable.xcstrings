          "stringUnit": {
            "state": "translated",
            "value": "La sessione resta aperta mentre Mixel Remote contatta di nuovo quel computer."
          }
        }
      }
    },
    "The sign-in screen of this Mac can be reached with Remote ID %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldebildschirm dieses Macs ist mit der Remote-ID %@ erreichbar."
