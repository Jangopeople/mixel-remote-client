        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite di tempo di questa sessione con password è stato raggiunto. La sessione termina ora."
          }
        }
      }
    },
    "The update could not be installed: %@": {
      "localizations": {
