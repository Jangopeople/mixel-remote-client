          "stringUnit": {
            "state": "translated",
            "value": "La schermata di accesso di questo Mac è raggiungibile con l’ID Remote %@."
          }
        }
      }
    },
    "The technician wants to show you their screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
