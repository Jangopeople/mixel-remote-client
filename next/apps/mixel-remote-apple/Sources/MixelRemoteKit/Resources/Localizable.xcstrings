    },
    "This app controls other devices; it cannot be controlled itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App steuert andere Geräte; sie selbst kann nicht gesteuert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app contrôle d’autres appareils ; elle ne peut pas être contrôlée elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app controlla altri dispositivi; non può essere controllata a sua volta."
          }
        }
      }
    },
    "This change needs the second confirmation step. Sign in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung erfordert den zweiten Bestätigungsschritt. Melden Sie sich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
