            "state": "translated",
            "value": "Il tecnico desidera mostrarLe il suo schermo."
          }
        }
      }
    },
    "The time limit of this password session is reached. The session ends now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitgrenze dieser Passwort-Sitzung ist erreicht. Die Sitzung endet jetzt."
          }
        },
