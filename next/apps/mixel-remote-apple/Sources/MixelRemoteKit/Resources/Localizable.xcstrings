    },
    "You are already connected to this computer. Switch to its tab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind mit diesem Computer bereits verbunden. Wechseln Sie zu seinem Tab."
          }
