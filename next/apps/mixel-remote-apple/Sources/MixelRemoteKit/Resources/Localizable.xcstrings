      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Computer hinzufügen und registrieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter et enregistrer cet ordinateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi e registra questo computer"
          }
        }
      }
