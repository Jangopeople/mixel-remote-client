    "A colleague invites you to a session": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kollegin oder ein Kollege lädt Sie zu einer Sitzung ein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collègue vous invite à une session"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collega La invita a una sessione"
          }
        }
      }
    },
    "A second technician wants to join": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zweiter Techniker möchte dazukommen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un deuxième technicien souhaite se joindre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secondo tecnico vuole partecipare"
          }
        }
      }
    },
    "A secure home for your devices and connections.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sicheres Zuhause für Ihre Geräte und Verbindungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace sûr pour vos appareils et vos connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazio sicuro per i tuoi dispositivi e le tue connessioni."
          }
        }
      }
    },
    "A technician can then reach this Mac at its sign-in screen, before anyone signs in. macOS asks for an administrator twice, and once at the sign-in screen for Screen Recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Technikerin oder ein Techniker erreicht diesen Mac dann am Anmeldebildschirm, bevor sich jemand anmeldet. macOS fragt zweimal nach einem Administrator und einmal am Anmeldebildschirm nach der Bildschirmaufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un technicien peut alors atteindre ce Mac à son écran de connexion, avant que quiconque ne se connecte. macOS demande deux fois un administrateur, et une fois à l’écran de connexion l’enregistrement de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tecnico può quindi raggiungere questo Mac alla schermata di accesso, prima che qualcuno acceda. macOS chiede due volte un amministratore e una volta, alla schermata di accesso, la registrazione dello schermo."
          }
        }
      }
    },
    "A technician is connected to this computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Techniker ist mit diesem Computer verbunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un technicien est connecté à cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tecnico è connesso a questo computer."
          }
        }
      }
    },
    "About and legal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über und Rechtliches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos et informations juridiques"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni e note legali"
          }
        }
      }
    },
    "Accept and save as…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Annehmen und speichern unter…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter et enregistrer sous…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta e salva con nome…"
          }
        }
      }
    },
    "Accept the Terms of Service and the Data Processing Agreement to create a company.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptieren Sie die Nutzungsbedingungen und den Auftragsverarbeitungsvertrag, um eine Firma zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptez les conditions d’utilisation et l’accord de sous-traitance pour créer une entreprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta le condizioni d’uso e l’accordo sul trattamento dei dati per creare un’azienda."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        },
        "it": {
          "stringUnit": {
