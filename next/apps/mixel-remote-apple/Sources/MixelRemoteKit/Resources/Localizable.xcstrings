    "The recording stopped early. The playable portion was saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung endete vorzeitig. Der abspielbare Teil wurde gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté plus tôt. La partie lisible a été sauvegardée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è interrotta prima. La parte riproducibile è stata salvata."
          }
        }
      }
    },
    "The remote computer could not type this text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der entfernte Computer konnte diesen Text nicht tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur distant n’a pas pu saisir ce texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il computer remoto non ha potuto digitare questo testo."
          }
        }
      }
    },
    "The remote computer did not come back within 10 minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der entfernte Computer ist innert 10 Minuten nicht zurückgekommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur distant n’est pas revenu dans les 10 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il computer remoto non è tornato entro 10 minuti."
          }
        }
      }
    },
    "The remote computer is restarting. Mixel Remote reconnects when it is back…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der entfernte Computer startet neu. Mixel Remote verbindet sich wieder, sobald er zurück ist…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur distant redémarre. Mixel Remote se reconnecte dès son retour…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il computer remoto si sta riavviando. Mixel Remote si ricollega appena torna disponibile…"
          }
        }
      }
    },
    "The session is ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung ist bereit."
          }
        },
        "fr": {
