          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre compte Mixel Remote et vous déconnecte sur tous les appareils. Les données de l’entreprise restent à l’entreprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella il Suo account Mixel Remote e La disconnette su tutti i dispositivi. I dati aziendali restano all’azienda."
