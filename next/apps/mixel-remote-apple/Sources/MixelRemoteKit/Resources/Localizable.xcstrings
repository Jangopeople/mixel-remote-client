          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha già aperto il numero massimo di sessioni che questa app può gestire. Ne termini una per collegarsi a un altro computer."
          }
        }
      }
    },
    "You are already connected to this computer.": {
      "localizations": {
