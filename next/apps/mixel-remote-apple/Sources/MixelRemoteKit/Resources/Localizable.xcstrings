    "Wake signal sent to %@. It shows Online when it has started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecksignal an %@ gesendet. Es zeigt Online, sobald es gestartet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal de réveil envoyé à %@. Il s’affiche En ligne une fois démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnale di riattivazione inviato a %@. Mostra Online quando si è avviato."
          }
        }
      }
    },
    "Windows (PowerShell, as administrator)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows (PowerShell, als Administrator)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
