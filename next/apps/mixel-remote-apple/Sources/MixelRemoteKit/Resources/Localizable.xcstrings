          }
        }
      }
    },
    "You type the ID under Connect and choose Connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie geben die ID unter Verbinden ein und wählen Verbinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous saisissez l’ID sous Connecter et choisissez Connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita l’ID in Connetti e sceglie Connetti."
          }
        }
      }
    },
    "Your 9-digit connection ID will appear automatically as soon as both permissions are switched on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre 9-stellige Verbindungs-ID erscheint automatisch, sobald beide Berechtigungen aktiviert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ID de connexion à 9 chiffres apparaîtra automatiquement dès que les deux autorisations seront activées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ID di connessione a 9 cifre apparirà automaticamente non appena entrambi i permessi saranno attivi."
          }
        }
      }
    },
    "Your approval is required for every connection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Verbindung braucht Ihre Zustimmung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque connexion nécessite votre accord"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni connessione richiede il tuo consenso"
          }
        }
      }
    },
    "Your browser opens; you confirm your e-mail address there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Browser öffnet sich; dort bestätigen Sie Ihre E-Mail-Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre navigateur s’ouvre ; vous y confirmez votre adresse e-mail."
          }
