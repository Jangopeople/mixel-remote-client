    "Deletes the company at once: devices, invitations, members and their accounts. The subscription ends. Type the company name to confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Firma sofort: Geräte, Einladungen, Mitglieder und ihre Konten. Das Abonnement endet. Geben Sie zur Bestätigung den Firmennamen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l’entreprise immédiatement : appareils, invitations, membres et leurs comptes. L’abonnement prend fin. Saisissez le nom de l’entreprise pour confirmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
