          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modifica richiede il secondo passaggio di verifica. Acceda di nuovo."
          }
        }
      }
    },
    "This company has no other technicians.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Firma hat keine weiteren Techniker."
          }
        },
        "fr": {
