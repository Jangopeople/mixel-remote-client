    "Allow screen recording for Mixel Remote in System Settings to share a screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Mixel Remote die Bildschirmaufnahme in den Systemeinstellungen, um einen Bildschirm zu teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’enregistrement de l’écran pour Mixel Remote dans les Réglages Système pour partager un écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenta la registrazione dello schermo a Mixel Remote nelle Impostazioni di Sistema per condividere uno schermo."
